[Unit]
Description=helopath web (gunicorn)
After=network.target

[Service]
User=__USER__
WorkingDirectory=/srv/helopath
EnvironmentFile=/srv/helopath/.env
ExecStart=/srv/helopath/.venv/bin/gunicorn config.wsgi:application --workers 2 --bind 127.0.0.1:8000 --timeout 60 --max-requests 1000
Restart=on-failure

[Install]
WantedBy=multi-user.target
