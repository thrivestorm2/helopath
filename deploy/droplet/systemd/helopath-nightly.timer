[Unit]
Description=Run helopath nightly ingest

[Timer]
# adsb.lol publishes the previous UTC day during the following day; run in the early evening UTC
# and let the nightly command catch up on anything missed (it looks back 3 days).
OnCalendar=*-*-* 18:30:00 UTC
RandomizedDelaySec=15m
Persistent=true

[Install]
WantedBy=timers.target
